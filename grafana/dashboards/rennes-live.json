          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT AVG(EXTRACT(EPOCH FROM processed_at - position_time)) FROM bus_positions_latest\nWHERE processed_at > (now() AT TIME ZONE 'UTC') - INTERVAL '1 minute'"
