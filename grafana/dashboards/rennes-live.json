    {
      "id": 8,
      "type": "table",
      "title": "Lignes les plus lentes (dernières 15 min)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "velo-pg"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "velo-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT COALESCE(r.short_name, a.route_id) AS ligne, round(AVG(a.avg_speed_kmh)::numeric, 1) AS \"km/h\", MAX(a.vehicles) AS \"véhicules\"\nFROM route_activity_1m a LEFT JOIN bus_routes r USING (route_id)\nWHERE a.window_start > (now() AT TIME ZONE 'UTC') - INTERVAL '15 minutes'\nGROUP BY 1 HAVING AVG(a.avg_speed_kmh) IS NOT NULL ORDER BY 2 LIMIT 10"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
