            "uid": "velo-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT a.event_time AS \"heure (UTC)\", COALESCE(s.name, a.station_id) AS station, a.alert_type AS alerte, a.bikes_available AS velos, a.docks_available AS places\nFROM station_alerts a LEFT JOIN stations s USING (station_id)\nWHERE $__timeFilter(a.event_time)\nORDER BY a.event_time DESC LIMIT 50"
