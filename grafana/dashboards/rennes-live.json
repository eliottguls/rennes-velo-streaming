          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT window_start AS time, SUM(vehicles) AS \"véhicules\"\nFROM route_activity_1m WHERE $__timeFilter(window_start)\nGROUP BY 1 ORDER BY 1"
